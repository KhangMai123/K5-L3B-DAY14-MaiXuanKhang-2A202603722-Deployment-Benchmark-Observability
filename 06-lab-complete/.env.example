# Copy to .env for local runs (never commit .env with real secrets)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Required for POST /ask (set a strong random key locally or on cloud platform)
AGENT_API_KEY=

# Shared Redis state (rate limiting and cost guard)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.5

# Protection limits
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
BUDGET_TIMEZONE=UTC
MAX_QUESTION_CHARS=2000
